# Immutable caching for assets that never change without a filename change.
# Fixes Chrome's "preloaded but not used" warnings on repeat views: with the
# Pages default (max-age=0, must-revalidate) every font preload triggered a
# revalidation whose response was never consumed.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# CSP scope audited A4-5. Every origin allowed below maps to a verified dependency:
#   assets.calendly.com  — widget.js (script), widget.css (style), close-icon.svg
#                          (img — root-relative url() inside that CSS)
#   calendly.com         — the booking iframe the widget injects
#   googletagmanager.com — gtag.js, rendered only when SITE_DATA.seo.googleAnalyticsId
#                          is set (src/layouts/BaseLayout.astro:106)
#   google-analytics.com — GA4 collect endpoint (connect) plus legacy pixel fallback
#                          (img); region1.google-analytics.com needs the wildcard
# 'unsafe-inline' is required: Astro emits every page script as an inline
# <script type="module">. 'unsafe-eval' is NOT required — there is no eval or
# new Function in dist/ or in Calendly's widget.js.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), autoplay=(self), fullscreen=(self), picture-in-picture=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://assets.calendly.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; font-src 'self' data:; img-src 'self' data: https://assets.calendly.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://calendly.com https://*.calendly.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self';
