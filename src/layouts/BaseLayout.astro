---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_DATA } from '../data/constants';
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
    bareLayout?: boolean;
    /** Keep the page out of search results. Must agree with the page's entry in
        src/data/seo-map.mjs, which also drives the sitemap filter — preflight
        PF-4 fails if the two disagree. */
    noindex?: boolean;
    /** Append " | Atlas Accounting Group" to the <title>.
     *
     *  Default true. Set false where the 25-char suffix costs more than it
     *  earns — blog posts, whose titles are long enough that the suffix pushes
     *  the keyword past Google's ~60-char display limit. 52 of the 62
     *  over-length titles on this site are blog posts; dropping the suffix
     *  there brings 36 of them back under.
     *
     *  Brand visibility does not depend on this. Brand queries ("atlas
     *  accounting group", 152 clicks/yr) land on the homepage, which keeps its
     *  suffix, and the og:site_name + WebSite schema below are what Google
     *  actually uses to render the site name in results. */
    brandSuffix?: boolean;
}

const {
  title,
  description = SITE_DATA.seo.description,
  bareLayout = false,
  noindex = false,
  brandSuffix = true,
} = Astro.props;

const pageTitle = brandSuffix ? `${title} | ${SITE_DATA.company.name}` : title;

// AccountingService schema — phone/address omitted (remote-first practice, email contact only)
const jsonLD: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  // Stable node identifier so other schema graphs (and Google) can reference
  // this business entity by @id rather than duplicating it.
  "@id": SITE_DATA.links.url + "/#organization",
  "name": SITE_DATA.company.name,
  "image": SITE_DATA.links.url + "/og-image.jpg",
  "email": SITE_DATA.company.email,
  "url": SITE_DATA.links.url,
  "parentOrganization": {
    "@type": "Organization",
    "name": "Lewis Group CPAs",
    "url": SITE_DATA.links.parentCompany
  },
  "sameAs": [SITE_DATA.links.socials.instagram],
  "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "09:00",
      "closes": "17:00"
    }
};
// WebSite node (checklist A3-3 / AI-readiness Tier 0 minimum set). Gives the
// site itself a stable @id that other graphs can hang off, and names the
// publisher by reference rather than duplicating the business node above.
// No `potentialAction`/SearchAction — the site has no internal search, and
// declaring one that does not exist is worse than declaring nothing.
const websiteLD = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": SITE_DATA.links.url + "/#website",
  "url": SITE_DATA.links.url,
  "name": SITE_DATA.company.name,
  "description": SITE_DATA.seo.description,
  "publisher": { "@id": SITE_DATA.links.url + "/#organization" },
  "inLanguage": "en-US"
};

if (SITE_DATA.company.phone) jsonLD.telephone = SITE_DATA.company.phone;
if (SITE_DATA.company.address.street) jsonLD.address = {
  "@type": "PostalAddress",
  "streetAddress": SITE_DATA.company.address.street,
  "addressLocality": SITE_DATA.company.address.city,
  "addressRegion": SITE_DATA.company.address.state,
  "postalCode": SITE_DATA.company.address.zip,
  "addressCountry": "US"
};

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* Favicons generated from the brand logo, composited on white so the navy
		    wordmark stays visible against dark browser chrome (the source SVG is
		    transparent, which renders the mark near-invisible in dark mode). */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
		<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta name="generator" content={Astro.generator} />
        <link rel="preload" href="/fonts/Sofia-Pro-Regular-Az.woff" as="font" type="font/woff" crossorigin />
        <link rel="preload" href="/fonts/Sofia-Pro-Semi-Bold-Az.woff" as="font" type="font/woff" crossorigin />
        <link rel="preload" href="/fonts/Sofia-Pro-Bold-Az.woff" as="font" type="font/woff" crossorigin />
        <meta name="theme-color" content={SITE_DATA.branding.colors.themeColor} />
		<title>{pageTitle}</title>

        {/* Canonical URL */}
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

        {/* Open Graph / Facebook */}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_DATA.company.name} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/og-image.jpg', Astro.url)} />

        {/* Twitter */}
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL('/og-image.jpg', Astro.url)} />

        {/* JSON-LD Schema */}
        <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteLD)} />

        {/* Google Analytics - Conditional */}
        {SITE_DATA.seo.googleAnalyticsId && (
            <>
                <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE_DATA.seo.googleAnalyticsId}`}></script>
                <script define:vars={{ gaId: SITE_DATA.seo.googleAnalyticsId }}>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', gaId);
                </script>
            </>
        )}
	</head>
	<body class={`min-h-screen flex flex-col${bareLayout ? '' : ' font-body'}`}>
		{!bareLayout && <a href="#main" class="skip-link">Skip to content</a>}
		{!bareLayout && <Nav />}
        <main id="main" class="flex-grow">
		    <slot />
        </main>
        {!bareLayout && <Footer />}
	</body>
</html>
