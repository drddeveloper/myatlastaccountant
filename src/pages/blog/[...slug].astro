---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DATA } from '../../data/constants';
import PageHero from '../../components/sections/PageHero.astro';
import CtaBand from '../../components/sections/CtaBand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// ── Per-post JSON-LD ────────────────────────────────────────────────────────
// BaseLayout emits the site-wide AccountingService node at
// <site>/#organization; this graph references that node by @id rather than
// duplicating the business. Only fields backed by real frontmatter are emitted
// — no invented dateModified, no fabricated author URL.
const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const orgId = SITE_DATA.links.url + '/#organization';

const blogPostingLD: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': postUrl + '#blogposting',
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  datePublished: post.data.pubDate.toISOString(),
  // The author string is either the firm or a named team member; Person vs
  // Organization is decided off the constants value, not guessed.
  author:
    post.data.author === SITE_DATA.company.name
      ? { '@id': orgId }
      : { '@type': 'Person', name: post.data.author },
  publisher: { '@id': orgId },
  isPartOf: { '@type': 'Blog', '@id': SITE_DATA.links.url + '/blog/#blog', name: 'Atlas Accounting Group Blog' },
};
if (post.data.image) blogPostingLD.image = new URL(post.data.image.src, Astro.site).href;
if (post.data.tags?.length) blogPostingLD.keywords = post.data.tags.join(', ');

const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DATA.links.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE_DATA.links.url + '/blog/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};
---

<BaseLayout title={post.data.title} description={post.data.description}>

  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLD)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} is:inline />

  <PageHero
    theme="cream"
    eyebrow={formatDate(post.data.pubDate)}
    title={post.data.title}
    subtitle={post.data.description}
  />

  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-16 md:py-24">
      {post.data.image && (
        <Image
          src={post.data.image}
          alt=""
          class="w-full max-w-3xl mx-auto aspect-video object-cover mb-12"
          widths={[768, 1200]}
          sizes="(min-width: 768px) 48rem, 100vw"
        />
      )}
      <div class="max-w-3xl mx-auto mb-8 flex flex-wrap items-center gap-x-6 gap-y-2">
        <p class="eyebrow">By {post.data.author}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2" role="list">
            {post.data.tags.map((tag) => (
              <li class="bg-cream-dark text-primary font-semibold px-3 py-1 text-xs uppercase tracking-wide">{tag}</li>
            ))}
          </ul>
        )}
      </div>
      <article class="prose max-w-3xl mx-auto">
        <Content />
      </article>
      <div class="max-w-3xl mx-auto mt-12">
        <a href="/blog/" class="btn btn-outline">&larr; Back to Blog</a>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Find out how we can help your trade business"
    ctaLabel="Book a Call"
  />

</BaseLayout>
