---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import LeadFormCta from '../components/sections/LeadFormCta.astro';
import BookkeepersDifferent from '../components/sections/BookkeepersDifferent.astro';
import AccurateBooks from '../components/sections/AccurateBooks.astro';


// Page-specific images (downloaded from the live /accountants-for-solar-companies/ page)
import heroImg from '../assets/images/pages/solar/Accounting-for-solar-companies.png';
import systemizeImg from '../assets/images/pages/solar/Group-2dd2.png';
import growImg from '../assets/images/pages/solar/Accountants-for-solar.png';

// Icons + testimonial photo shared by the electrical / plumbing / solar trade pages
import testimonialImg from '../assets/images/pages/shared/Ryann-Blake-Testimonial.jpg';
import icon360Financial from '../assets/images/pages/shared/360-financial-icon.svg';
import iconFileBox from '../assets/images/pages/shared/File-Box.svg';
import iconInvoice from '../assets/images/pages/shared/Invoice.svg';
import iconData from '../assets/images/pages/shared/Data.svg';
import iconCheck from '../assets/images/pages/shared/checkmark-accent.svg';
import iconCpu from '../assets/images/pages/shared/cpu-icon.svg';
import iconFinancial from '../assets/images/pages/shared/financial-icon.svg';
import iconDocCalc from '../assets/images/pages/shared/document-with-calculator.svg';
import iconTax from '../assets/images/pages/shared/tax-1.svg';
import iconWorkflow from '../assets/images/pages/shared/workflow.svg';

// Linked service cards. Live card 1 links to /bookkeeper-for-construction/ —
// no route in this build → nearest existing route (/pricing/).
const serviceCards = [
  { icon: iconFileBox, title: 'Clean books and smart job costing', href: '/pricing/' },
  { icon: iconInvoice, title: 'Payroll and cash flow planning that fit your seasonality', href: '/construction-payroll/' },
  { icon: iconData, title: 'Support from real humans who know the solar space', href: '/meet-the-team/' },
];

// Benchmark assessment pills (live: three white pills on the orange band)
const assessmentQuestions = [
  'Is your growth where it should be?',
  'Are your business tools holding you back?',
  'Is it time for an accountant?',
];

// "Push you farther" icon boxes (live: row of three + centered row of two)
const capabilities = [
  { icon: iconCpu, title: 'Bring your technology up to speed' },
  { icon: iconFinancial, title: 'Manage & forecast cash flow' },
  { icon: iconDocCalc, title: 'Increase profitability through smarter accounting' },
  { icon: iconTax, title: 'Find thousands of dollars In tax breaks' },
  { icon: iconWorkflow, title: 'Build better accounting workflows' },
];
---

{/* Live <title>/meta are copy-pasted from the construction page — the solar-specific
    title/description below are kept instead (per the rebuild fix list). */}
<BaseLayout
  title="Accountants for Solar Companies | Bookkeeping | Payroll | Tax"
  description="Atlas Accounting Group is the accountant for solar companies — clean books, job costing, payroll, and cash flow built around your install calendar. Book a call."
>

  {/* Per-page Service schema (A3-3). Description is the page's own meta
      description, so the two cannot drift. */}
  <ServiceSchema
    name="Accounting for Solar Companies"
    description="Atlas Accounting Group is the accountant for solar companies — clean books, job costing, payroll, and cash flow built around your install calendar. Book a call."
    serviceType="Accounting"
    audience="Solar installation companies"
  />

  {/* ── Hero (live: white bg, text 57% / image 42%) ── */}
  <section class="bg-base-100 hero-media-first">
    <div class="container mx-auto px-4 grid gap-x-10 lg:grid-cols-[4fr_3fr] items-stretch">
      {/* .hero-copy owns the vertical padding (--hero-pad-y) so .hero-media
          can run flush to the sections above and below */}
      <div class="hero-copy">
        <h1 class="heading-display text-4xl md:text-5xl xl:text-6xl text-secondary">
          we're accountants who specialize in <span class="text-sky-ink">Solar Companies</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed max-w-xl">
          What does financial success look like for your solar business?
        </p>
        <div class="mt-8">
          <a href="#schedule" class="btn btn-accent">Book A Discovery Call</a>
        </div>
      </div>
      <div class="hero-media">
        <Image src={heroImg} alt="Two installers carrying a solar panel across a tiled roof" widths={[480, 768, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  {/* ── Close your eyes (live: navy band, centered) ── */}
  <section class="bg-primary">
    <div class="container mx-auto px-4 py-16 md:py-24 text-center">
      <h2 class="heading-display text-3xl md:text-5xl text-white max-w-4xl mx-auto">
        Close Your Eyes <span class="text-sky">And Picture It</span>
      </h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-white/90 max-w-4xl mx-auto">
        <p>What does your dream solar business look like?</p>
        <p>
          Maybe it’s a warehouse buzzing with installs.<br />
          Maybe it’s a team that finally runs like a well-oiled machine.<br />
          Maybe it’s steady, reliable profits… and time off when you want it.
        </p>
        <p>Now open your eyes. How close are you?</p>
        <p>We know that solar founders are building more than just a business. You’re pushing for growth, sustainability, and something that lasts. But it’s hard to keep your books clean when you’re managing installs, permits, team payroll, and a hundred other moving pieces.</p>
        <p>That’s where we come in.</p>
      </div>
    </div>
  </section>

  {/* ── Services (live: cream body bg, centered heading, orange card + 3 linked white cards, 2px gaps) ── */}
  <section class="bg-cream">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-display text-3xl md:text-5xl text-secondary">
          Built For Solar Businesses<br /> <span class="text-sky-ink">Like Yours</span>
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          At Atlas Accounting Group, we help solar company owners get the financial clarity and systems they need to make better decisions, and hit the next stage of growth.
        </p>
      </div>
      <div class="mt-12 grid gap-0.5 grid-cols-2 lg:grid-cols-4">
        {/* Card 1 — orange, not linked on the live page. Navy title (live white fails contrast on orange). */}
        <div class="bg-accent px-6 py-12 flex flex-col items-center text-center">
          <Image src={icon360Financial} alt="" class="h-[70px] w-auto" width={70} height={70} aria-hidden="true" />
          <h3 class="text-2xl font-bold text-primary mt-6">Monthly financials you can actually use</h3>
        </div>
        {/* Cards 2–4 — white, whole card is the link (as on live) */}
        {serviceCards.map((card) => (
          <a href={card.href} class="card-tile group px-6 py-12 items-center text-center">
            <Image src={card.icon} alt="" class="h-[70px] w-auto" width={70} height={70} aria-hidden="true" />
            <h3 class="text-2xl font-bold text-secondary mt-6">{card.title}</h3>
            <span class="mt-auto pt-6 inline-flex items-center gap-2 font-semibold text-base md:text-lg whitespace-nowrap text-accent-ink group-hover:text-accent transition-colors">
              Learn More
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"/></svg>
              <span class="sr-only"> — {card.title}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── Systemize (live: white, text left / image right) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-16 md:py-24 grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="heading-display text-3xl md:text-5xl text-secondary">
          <span class="text-sky-ink">Systemize</span> Your Solar Accounting
        </h2>
        <p class="mt-6 leading-relaxed">
          Are you stressed about cash flow… not knowing how much money will be coming into and out of the business, and when? Do you feel like you’re always running around putting out fires because you don’t have a comprehensive and strategic plan in place? At Atlas Accounting Group, we help you systemize your solar business through automated technology, real-time data, and improved internal workflows so you always have a grip on the full picture of your business.
        </p>
      </div>
      <Image src={systemizeImg} alt="Xero, Gusto, ServiceTitan, QuickBooks and Jobber logos over a construction site" class="w-full h-auto" widths={[480, 700]} sizes="(min-width: 1024px) 45vw, 100vw" />
    </div>

    {/* ── Grow (live: white, image left / text right) ── */}
    <div class="container mx-auto px-4 pb-16 md:pb-24 grid gap-12 lg:grid-cols-2 lg:items-center">
      <Image src={growImg} alt="Two solar installers in hard hats setting a panel onto a roof frame" class="w-full h-auto order-last lg:order-first" widths={[480, 768, 1050]} sizes="(min-width: 1024px) 45vw, 100vw" />
      <div>
        <h2 class="heading-display text-3xl md:text-5xl text-secondary">
          Find Opportunities to <span class="text-sky-ink">grow your solar business</span>
        </h2>
        <p class="mt-6 leading-relaxed">
          We’ll dive into your business to pull out any low-hanging revenue opportunities we see, find ways to cut down on unnecessary expenses, and help you manage your money in a way that brings in more profits month-on-month.
        </p>
      </div>
    </div>
  </section>

  <BookkeepersDifferent />

  <AccurateBooks trade="solar" />

  {/* ── Benchmark assessment (live: orange band; navy text kept for WCAG contrast on orange).
       Live "Start Assessment" button opens a Typeform quiz. The quiz was never
       migrated, so this scrolls to the lead form at the foot of the page. ── */}
  <section class="bg-accent">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow text-primary mb-4">Get Your Benchmark Assessment</p>
        <h2 class="heading-display text-3xl md:text-5xl text-primary">
          How does Your business stack up?
        </h2>
        <p class="mt-4 text-2xl font-medium text-primary">Let’s assess…</p>
      </div>
      <ul class="mt-12 grid gap-4 md:gap-10 lg:grid-cols-3 max-w-5xl mx-auto" role="list">
        {assessmentQuestions.map((q) => (
          <li class="flex items-start gap-4 bg-base-100 px-5 py-3.5">
            <Image src={iconCheck} alt="" class="h-10 w-10 shrink-0" width={42} height={42} aria-hidden="true" />
            <span class="text-xl md:text-2xl font-bold text-secondary">{q}</span>
          </li>
        ))}
      </ul>
      <div class="mt-12 text-center">
        <a href="#schedule" class="btn btn-primary">Schedule Free Assessment</a>
      </div>
    </div>
  </section>

  {/* ── Push you farther (live: white, centered icon boxes — row of 3 + centered row of 2 — then button) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <h2 class="heading-display text-3xl md:text-5xl text-secondary text-center max-w-4xl mx-auto">
        Work with Solar accountants <span class="text-sky-ink">who push you farther</span>
      </h2>
      {/* Mobile: one box per row, icon left with the title beside it, both
          left-aligned and vertically centred — stacked-and-centred was hard to
          scan on a phone. sm and up: two columns with the icon back above the
          title, matching the 2×2 service cards. An odd final box spans both
          columns and centres itself rather than leaving a hole in the grid; its
          max-w matches one column exactly (half the track, less half the 1.5rem
          gap). */}
      <div class="mt-14 grid gap-x-6 gap-y-8 sm:gap-y-12 sm:grid-cols-2 max-w-3xl mx-auto">
        {capabilities.map((cap, i) => (
          <div class:list={[
            'flex items-center gap-5 text-left sm:flex-col sm:gap-0 sm:text-center',
            i === capabilities.length - 1 && capabilities.length % 2 === 1 && 'sm:col-span-2 sm:max-w-[calc(50%-0.75rem)] sm:mx-auto',
          ]}>
            <Image src={cap.icon} alt="" class="h-16 w-auto shrink-0 sm:h-20 sm:mx-auto" width={85} height={85} aria-hidden="true" />
            <h3 class="heading-display text-lg md:text-xl text-secondary sm:mt-6">{cap.title}</h3>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/why-we-are-different/" class="btn btn-accent">What's It Like To Work With Us?</a>
      </div>
    </div>
  </section>

  {/* ── Testimonial (live: cream body bg, photo w/ name overlay + quote) ── */}
  <section class="bg-cream">
    <div class="container mx-auto px-4 py-16 md:py-24 grid gap-12 lg:grid-cols-[9fr_11fr] lg:items-center">
      <div class="relative">
        <Image src={testimonialImg} alt="Ryann Blake, owner of Chimney Techniques" class="w-full h-auto" widths={[420, 525]} sizes="(min-width: 1024px) 40vw, 100vw" />
        {/* Live overlays the name bottom-left in white; gradient added so the text passes contrast */}
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent pt-16 pb-6 px-8">
          <p class="heading-display text-2xl md:text-3xl text-white">Ryann Blake</p>
          <p class="text-white text-lg uppercase">Owner of Chimney Techniques</p>
        </div>
      </div>
      <figure>
        <blockquote>
          <p class="heading-display text-3xl md:text-4xl text-secondary">
            “I now have a <span class="text-sky-ink">full understanding</span> of my financial position.”
          </p>
          <p class="mt-6 leading-relaxed">
            Working with Atlas Accounting Group has completely changed the outlook of my business. When we started our partnership, I knew very little about the financial health of my company. Like many small business owners, I had a family member overseeing everything. When retirement forced a change, Alysia took the reins and because of her I now have a full understanding of my financial position and am able to make educated business decisions instead of basing them on guesses and feelings.
          </p>
        </blockquote>
        <figcaption class="sr-only">Ryann Blake, Owner of Chimney Techniques</figcaption>
      </figure>
    </div>
  </section>

  <LeadFormCta heading="Find out how we can help your solar business" />

</BaseLayout>
