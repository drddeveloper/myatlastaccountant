---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceSchema from '../components/ServiceSchema.astro';
import LeadFormCta from '../components/sections/LeadFormCta.astro';

import iconPartner from '../assets/images/pages/tax/6570643_annual_cost_fee_legal_money_icon-1.svg';
import iconSupport from '../assets/images/pages/tax/6570641_annual_calculate_cost_data_payment_icon-1.svg';
import iconSave from '../assets/images/pages/tax/6570638_annual_cost_fee_legal_money_icon-1.svg';
import iconDeductions from '../assets/images/pages/tax/6570644_annual_data_document_fee_legal_icon-1.svg';
import iconFile from '../assets/images/pages/tax/6570650_annual_calculate_data_document_fee_icon-1.svg';
import iconMaximize from '../assets/images/pages/tax/6570652_management_icon-1.svg';
import longTermImg from '../assets/images/pages/tax/Contractor-Taxes.webp';
import lowTaxesImg from '../assets/images/pages/tax/Contractor-Tax-Services.webp';
import testimonialImg from '../assets/images/pages/tax/Ryann-Blake-Testimonial.jpg';

// Copy repositioned 2026-08-12 (client direction): the page previously read as
// "we partner with people who file taxes", which had clients assuming filing
// was something they still had to go and buy elsewhere. Filing IS one of our
// services — delivered through Lewis Group CPAs — and the copy now says so.
const filingPoints = [
  {
    icon: iconPartner,
    title: 'We file your return',
    body: "Tax filing is one of our services, not a referral out the door. Your return is prepared, signed, and filed by our CPA firm, Lewis Group CPAs, the same people who already know your books. Happy with a CPA you've used for years? We'll work alongside them instead. Either way it's smart planning, not shortcuts.",
  },
  {
    icon: iconSupport,
    title: 'Gain year round support',
    body: 'No matter which plan you choose with Atlas Accounting Group, you will gain year-round advisory support to ensure that you’re making the most tax-efficient financial decisions.',
  },
  {
    icon: iconSave,
    title: 'Save money with industry expertise',
    body: 'Working with general tax accountants can often result in missed tax deductions or credits that are suitable for your specific industry. With Atlas Accounting Group, you can be sure that every savings is accounted for.',
  },
];

const processSteps = [
  { icon: iconDeductions, title: 'We Finalize Accurate Deductions & Reports' },
  { icon: iconFile, title: 'Lewis Group CPAs File & Submit Your Return' },
  { icon: iconMaximize, title: 'Together, We Maximize Your Business Potential' },
];
---

<BaseLayout
  title="Strategic Tax Services for Construction"
  description="Construction tax services from accountants who know the trades. We file your return through our CPA firm, Lewis Group CPAs - year-round planning, not April panic."
>

  {/* Per-page Service schema (A3-3). Description is the page's own meta
      description, so the two cannot drift. */}
  <ServiceSchema
    name="Construction Tax Services"
    description="Construction tax services from accountants who know the trades. We file your return through our CPA firm, Lewis Group CPAs - year-round planning, not April panic."
    serviceType="Tax preparation and planning"
    audience="Construction and specialty trade businesses"
  />

  {/* ── Hero — white, centered (live 26434aa1; its heading is an <h2> — ours is a proper h1) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 pt-12 pb-16 md:pt-16 md:pb-24 text-center">
      <h1 class="heading-display text-4xl md:text-5xl xl:text-6xl text-secondary max-w-4xl mx-auto">
        Construction Tax Services Without <span class="text-sky-ink">The Tax Stress</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed max-w-3xl mx-auto">
        We file your business taxes, through our CPA firm, Lewis Group CPAs, alongside the bookkeeping, payroll, and advisory we already run for you. One roof, one team, and books that are current all year, so there are no nasty surprises in April.
      </p>
      <div class="mt-8">
        <a href="#schedule" class="btn btn-accent">Book Your Discovery Call</a>
      </div>
    </div>
  </section>

  {/* ── Tax filing is one of our services — cream, three centered tiles (live 3327a32) ── */}
  <section class="bg-cream">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="heading-display text-3xl md:text-4xl text-secondary">
          Yes - We File Your Taxes
        </h2>
        <p class="mt-5 text-lg leading-relaxed">
          Tax filing is a service you get from us, delivered through our CPA firm, Lewis Group CPAs. That covers full tax compliance: federal and state income tax returns, sales tax, payroll tax, property tax, and excise tax. You don&rsquo;t need to go and find a separate tax preparer.
        </p>
      </div>
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {filingPoints.map((col) => (
          <div class="text-center">
            <Image src={col.icon} alt="" class="h-20 w-auto mx-auto" width={99} height={84} aria-hidden="true" />
            <h3 class="heading-display text-xl text-secondary mt-5">{col.title}</h3>
            <p class="mt-4 leading-relaxed max-w-sm mx-auto">{col.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Are your books a mess? — navy band (live 83f9922) ── */}
  <section class="bg-primary">
    <div class="container mx-auto px-4 py-16 md:py-20 text-center">
      <h2 class="heading-display text-3xl md:text-4xl text-white">Are Your Books a Mess?</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/85 max-w-3xl mx-auto">
        We deal with messy, incomplete, and long overdue books all the time. In fact, we expect it! It’s our job to wipe the slate clean. Check out our ongoing bookkeeping services to ensure your financial numbers are up-to-date and accurate moving forward from here!
      </p>
      <div class="mt-8">
        {/* Live links to /bookkeeper-for-construction/ (dead slug) — routed to the
            construction industry page, which covers ongoing bookkeeping. */}
        <a href="/construction-accountants/" class="btn btn-accent">Learn More</a>
      </div>
    </div>
  </section>

  {/* ── How your tax filing works — cream, three heading-only tiles (live 8ce617f) ── */}
  <section class="bg-cream">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <h2 class="heading-display text-3xl md:text-4xl text-secondary text-center max-w-3xl mx-auto">
        How Your Tax Filing Works
      </h2>
      <div class="mt-14 grid gap-x-8 gap-y-12 md:grid-cols-3">
        {processSteps.map((step) => (
          <div class="text-center">
            <Image src={step.icon} alt="" class="h-20 w-auto mx-auto" width={88} height={84} aria-hidden="true" />
            <h3 class="heading-display text-xl md:text-2xl text-secondary mt-5 max-w-xs mx-auto">{step.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Long-term success — white, photo left / text right (live 2344c8d) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-16 md:py-24 grid gap-12 lg:grid-cols-2 lg:items-center">
      <Image src={longTermImg} alt="Two electricians stand in front of their work truck." class="w-full h-auto order-last lg:order-first" widths={[560, 768, 900]} sizes="(min-width: 1024px) 45vw, 100vw" />
      <div>
        <h2 class="heading-display text-3xl md:text-4xl text-secondary">
          Focus on your <span class="text-sky-ink">Long-term Financial success</span>
        </h2>
        <p class="mt-6 leading-relaxed">
          At Atlas Accounting Group, we take a look at the current financial position of your business, and implement accounting services that support your short and long-term goals. This includes comprehensive tax strategy, forecasting, cash-flow support, and strategic advisory calculations. We ensure your business is performing at its ultimate potential.
        </p>
      </div>
    </div>
  </section>

  {/* ── Taxes as low as legally possible — white, text left / photo right (live a1f2b64) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 pb-16 md:pb-24 grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="heading-display text-3xl md:text-4xl text-secondary">
          Focus on How to keep taxes as low <span class="text-sky-ink">as legally possible</span>
        </h2>
        <p class="mt-6 leading-relaxed">
          If you’ve been working with a 1990s, generic tax accountant, chances are that your tax advice and strategy has been outdated as well. Because we keep your books and file your return, nothing gets lost in the handoff, so you receive the latest, industry-specific grants, deductions, and credits down to the last cent each year.
        </p>
      </div>
      <Image src={lowTaxesImg} alt="Contractor in a hi-vis vest checking figures on a laptop on site" class="w-full h-auto" widths={[560, 768, 900]} sizes="(min-width: 1024px) 45vw, 100vw" />
    </div>
  </section>

  {/* ── Testimonial — cream, photo with name overlay + quote (live 6cb7c055) ── */}
  <section class="bg-cream">
    <div class="container mx-auto px-4 py-16 md:py-24 grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative max-w-xl">
        <Image src={testimonialImg} alt="Ryann Blake, owner of Chimney Techniques" class="w-full h-auto block" widths={[480, 525]} sizes="(min-width: 1024px) 45vw, 100vw" />
        {/* Bottom wash keeps the white name legible over the photo */}
        <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
        <div class="absolute bottom-5 left-5">
          <p class="heading-display text-2xl md:text-3xl text-white">Ryann Blake</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-white">Owner of Chimney Techniques</p>
        </div>
      </div>
      <figure>
        <blockquote>
          <p class="heading-display text-3xl md:text-4xl text-secondary">
            "I now have a <span class="text-sky-ink">full understanding</span> of my financial position."
          </p>
          <p class="mt-6 leading-relaxed">
            Working with Atlas Accounting Group has completely changed the outlook of my business. When we started our partnership, I knew very little about the financial health of my company. Like many small business owners, I had a family member overseeing everything. When retirement forced a change, Alysia took the reins and because of her I now have a full understanding of my financial position and am able to make educated business decisions instead of basing them on guesses and feelings.
          </p>
        </blockquote>
        <figcaption class="sr-only">Ryann Blake — Owner of Chimney Techniques</figcaption>
      </figure>
    </div>
  </section>

  <LeadFormCta heading="Find out how we can help your trade business" />

</BaseLayout>
