---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadFormCta from '../components/sections/LeadFormCta.astro';

import imgKpiDash from '../assets/images/pages/toolbox/KPI-Dash.png';
import imgProfAlloc from '../assets/images/pages/toolbox/Prof-Alloc-Proj.png';
import imgCashFlow from '../assets/images/pages/toolbox/Cash-Flow-Forecast-Thumbnail.png';
import imgLaborBurden from '../assets/images/pages/toolbox/Labor-Burden-Calculator-Thumbnail.png';
import imgChartOfAccounts from '../assets/images/pages/toolbox/Chart-of-Accounts-Thumbnail.png';
import imgProfitAndLoss from '../assets/images/pages/toolbox/Profit-and-Loss-Thumbnail.png';

// The Kajabi store is retired (client direction, 2026-08-04): no checkout, no
// prices, no pre-order/waitlist cards. Everything here is a free download.
//
// Every tool is a real file in public/downloads/ that downloads on click, and
// every one now ships with its own thumbnail.
const tools = [
  {
    name: 'Standard Chart of Accounts',
    blurb: 'A ready-made chart of accounts for contractors and trade businesses, laid out with account number, name, type, and detail type. Use it as the starting point when you set up — or clean up — your books.',
    file: '/downloads/Atlas-Standard-Chart-of-Accounts.xlsx',
    fileType: 'XLSX',
    img: imgChartOfAccounts,
    alt: 'Spreadsheet of a contractor chart of accounts, listing account numbers, names, and types from checking through other current assets.',
  },
  {
    name: 'Sample P&L by Class or Project',
    blurb: 'See what a job-level profit and loss statement should actually look like. This sample breaks revenue, direct costs, and change orders out by project so you can tell which jobs made money and which only looked like they did.',
    file: '/downloads/Atlas-Sample-PL-by-Class-or-Project.csv',
    fileType: 'CSV',
    img: imgProfitAndLoss,
    alt: 'Sample job-level profit and loss statement showing revenue, accounts receivable, and direct costs broken out line by line with notes.',
  },
  {
    name: 'KPI Dashboard',
    blurb: 'Built for busy business owners, this KPI dashboard workbook gives you a clear snapshot of your performance so you can spend less time on spreadsheets and more time growing your business.',
    file: '/downloads/Atlas-KPI-Dashboard-for-Contractors.xlsx',
    fileType: 'XLSX',
    img: imgKpiDash,
    alt: '',
  },
  {
    name: 'Profit Allocation Projector',
    blurb: 'Stop guessing where your profit is going. This tool helps you plan and project how earnings will be used, whether for reinvestment, debt payoff, or owner draws, so every dollar has a job.',
    file: '/downloads/Atlas-Profit-Allocation-Projector.xlsx',
    fileType: 'XLSX',
    img: imgProfAlloc,
    alt: '',
  },
  {
    name: 'Cash Flow Forecast',
    blurb: 'Stay ahead of cash crunches with a clear month-by-month view of income, expenses, and ending balance. This tool helps you make confident financial decisions before the pressure hits.',
    file: '/downloads/Atlas-Cash-Flow-Forecast-for-Contractors.xlsx',
    fileType: 'XLSX',
    img: imgCashFlow,
    alt: '',
  },
  {
    name: 'Labor Burden Calculator',
    blurb: 'Labor costs more than wages. This tool calculates the full cost per employee, including taxes and benefits, so you can price jobs right, manage overhead, and hire smarter.',
    file: '/downloads/Atlas-Labor-Burden-Calculator.xlsx',
    fileType: 'XLSX',
    img: imgLaborBurden,
    alt: '',
  },
];


// Live cards are one whole-card link with a flat surface that lifts on hover.
const cardClasses =
  'flex flex-col p-2.5 bg-base-100 transition-shadow hover:shadow-[0_14px_40px_0_rgba(0,0,0,0.1)] focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2';
---

{/* Meta rewritten 2026-08-04 — the live one was an auto-generated excerpt
    run-on, and it described a paid store that no longer exists. */}
<BaseLayout
  title="Toolbox"
  description="Free spreadsheets and templates for contractors and trade businesses — a standard chart of accounts, a sample job-level P&L, a KPI dashboard, and more. No cost, no catch."
>

  {/* ── Hero (live: white, centered; the live page has no h1 — promoted here for a11y) ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 pt-12 pb-16 md:pt-16 md:pb-24 text-center">
      <h1 class="heading-display text-4xl md:text-6xl text-secondary">Your Financial Toolbox</h1>
      <p class="mt-5 text-lg max-w-2xl mx-auto">Simple, helpful tools to help you build a financially stronger business — free to download and yours to keep.</p>
    </div>
  </section>

  {/* ── Trust band (live: navy strip between hero and grid) ── */}
  <section class="bg-primary">
    <div class="container mx-auto px-4 py-8 md:py-12">
      <p class="text-center text-white font-semibold uppercase tracking-[0.2em] text-sm md:text-base">
        Loved and trusted by Contractors Nationwide
      </p>
    </div>
  </section>

  {/* ── Tool grid — six free downloads, whole card is the link.
       Was 4 columns when the store carried 8 paid products; 3 across now. ── */}
  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 max-w-6xl mx-auto">

        {tools.map((t) => (
          <a href={t.file} download class={cardClasses}>
            <Image src={t.img} alt={t.alt} class="w-full aspect-3/2 object-cover" widths={[400, 800, 1200]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
            <div class="mt-4 px-1.5 pb-1.5 flex flex-col flex-grow">
              {/* h2 keeps the outline h1 → h2 (live uses non-semantic divs);
                  live tool titles are bold but not uppercase */}
              <h2 class="text-xl font-bold text-secondary normal-case">{t.name}</h2>
              <p class="mt-3 text-sm leading-relaxed flex-grow">{t.blurb}</p>
              <div class="mt-5 flex items-center justify-end">
                <span class="btn btn-accent">
                  Download<span class="sr-only"> — {t.name} ({t.fileType} file)</span>
                </span>
              </div>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <LeadFormCta heading="Find out how we can help your trade business" />

</BaseLayout>
