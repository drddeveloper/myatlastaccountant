---
import { SITE_DATA } from '../data/constants';

/**
 * Desktop-only floating CTA pinned to the right edge, offering the two fastest
 * ways to reach the firm: phone, or the lead form at the bottom of the page.
 *
 * Desktop only by design — on a phone it would cover a meaningful slice of the
 * viewport, and the mobile menu already pins Call + Contact to its footer.
 *
 * Non-modal: it never traps focus or blocks the page. Dismissal is remembered
 * for the browser session so it doesn't reappear on every navigation.
 */
---

<aside
  class="assessment-cta hidden lg:block fixed right-6 top-1/2 z-40 w-[19rem] bg-primary shadow-2xl"
  aria-labelledby="assessment-cta-heading"
  data-assessment-cta
>
  <button
    type="button"
    class="absolute top-2.5 right-2.5 inline-flex items-center justify-center h-9 w-9 text-white hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
    data-assessment-cta-close
  >
    <span class="sr-only">Close the schedule assessment panel</span>
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>

  <div class="px-7 py-8">
    <h2 id="assessment-cta-heading" class="heading-display text-2xl text-white">
      Schedule <span class="text-sky">Free Assessment</span>
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-white/85">
      No cost, no obligation - just a straight read on where your numbers stand.
    </p>
    <div class="mt-6 flex flex-col gap-3">
      <a href={SITE_DATA.company.phoneHref} class="btn btn-accent w-full">
        Call {SITE_DATA.company.phone}
      </a>
      <a href="#schedule" class="btn btn-outline-light w-full" data-assessment-cta-contact>
        Contact
      </a>
    </div>
  </div>
</aside>

<style>
  /* The closed state is expressed with visibility/opacity, never by toggling
     Tailwind's `hidden`: `hidden lg:block` is what keeps this off phones, and
     scripting the class away would defeat that guard and show the panel on
     mobile. visibility also makes it inert while closed, so an off-screen
     panel can't be tabbed into or add scrollable overflow. */
  .assessment-cta {
    /* Vertically centred, then slid off the right edge until it's revealed */
    transform: translate(calc(100% + 1.5rem), -50%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.5s ease-out,
      opacity 0.5s ease-out,
      visibility 0s linear 0.5s;
  }
  .assessment-cta[data-open] {
    transform: translate(0, -50%);
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.5s ease-out,
      opacity 0.5s ease-out,
      visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .assessment-cta {
      transition: opacity 0.2s ease-out, visibility 0s linear 0.2s;
      transform: translate(0, -50%);
    }
    .assessment-cta[data-open] {
      transition: opacity 0.2s ease-out, visibility 0s;
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-assessment-cta]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-assessment-cta-close]');
  const KEY = 'atlas-assessment-cta-dismissed';

  if (panel && closeBtn && !sessionStorage.getItem(KEY)) {
    // Short delay so it doesn't compete with the initial page render
    setTimeout(() => {
      panel.setAttribute('data-open', '');
    }, 2000);

    const close = () => {
      sessionStorage.setItem(KEY, '1');
      panel.removeAttribute('data-open');
      let removed = false;
      const remove = () => {
        if (removed) return;
        removed = true;
        panel.remove();
      };
      panel.addEventListener('transitionend', remove, { once: true });
      setTimeout(remove, 600); // fallback (e.g. prefers-reduced-motion)
    };

    closeBtn.addEventListener('click', close);

    // Once they're at the form the panel is redundant and overlaps it, so
    // clicking Contact dismisses it on the way down.
    panel
      .querySelector<HTMLAnchorElement>('[data-assessment-cta-contact]')
      ?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.isConnected && panel.hasAttribute('data-open')) {
        close();
      }
    });
  }
</script>
