---
import { ANALYTICS } from '../data/constants';

/**
 * Every third-party tag on the site, in one place.
 *
 * Two slots only — the GTM container (which owns all Google/Meta/Clarity tags)
 * and the DRD first-party tracker. See the ANALYTICS block in constants.ts for
 * why it is split that way and what still needs configuring in the GTM UI.
 *
 * Both are guarded on a non-empty id, so blanking either one in constants.ts
 * removes it from the build entirely rather than emitting a broken tag.
 *
 * `slot="body"` renders the GTM <noscript> iframe, which has to sit immediately
 * after <body>. BaseLayout renders this component twice: once in <head> for the
 * scripts, once at the top of <body> with body="true" for the noscript.
 */
interface Props {
  /** Render the <body> half (the GTM noscript iframe) instead of the <head> half. */
  body?: boolean;
}

const { body = false } = Astro.props;

const { gtmId, drd } = ANALYTICS;
const drdEnabled = Boolean(drd.key && drd.endpoint && drd.script && drd.hosts?.length);
---

{body ? (
  gtmId && (
    /* No-JS fallback. Must be the first thing inside <body> per Google's snippet. */
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
        aria-hidden="true"
      ></iframe>
    </noscript>
  )
) : (
  <>
    {gtmId && (
      /* GTM, deferred until after LCP (client direction, 2026-08-13).
         PageSpeed measured LCP 8.2s on mobile with 2,060ms of it "element
         render delay" — the hero image finished downloading in 90ms and then
         waited on the main thread while the container's three scripts (524 KiB,
         241 KiB of it unused) parsed and executed.
         The container now loads on whichever comes FIRST:
           - the load event, then the first idle callback  (the normal path)
           - any user interaction, including scroll         (the early path)
           - a long hard cap                                (safety net only)

         TWO REAL COSTS, both inherent to deferring rather than bugs:
         1. A visitor who bounces without scrolling, before load, is never
            recorded at all.
         2. Google Ads call tracking lives in this container and rewrites the
            phone number on the page. Deferred, it now swaps LATER — a visitor
            who taps "Call" immediately gets the real number, so that call goes
            unattributed. That matters here: the floating CTA leads with a phone
            button. If call attribution turns out to be worth more than the LCP
            gain, this is the change to reconsider first. */
      <script is:inline define:vars={{ gtmId }}>
        // dataLayer has to exist from the very first byte even though the
        // container does not: anything on the page may push to it meanwhile,
        // and those pushes must queue rather than throw.
        window.dataLayer = window.dataLayer || [];

        (function () {
          // Safety net ONLY — for a page whose load event never fires. It is
          // deliberately long: PageSpeed's slow-4G profile measured LCP at
          // 8.2s, so a short cap would fire before LCP on exactly the
          // connection this change exists to help, and undo it. The real early
          // trigger is interaction, and `scroll` catches almost everyone who
          // engages at all.
          var HARD_CAP_MS = 10000;
          var EVENTS = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
          var started = false;
          var capTimer;

          function start() {
            if (started) return;
            started = true;
            clearTimeout(capTimer);
            EVENTS.forEach(function (e) {
              window.removeEventListener(e, start, true);
            });
            // gtm.start is stamped here, not at page load, so GTM's own timing
            // reports measure the container rather than the document.
            window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var first = document.getElementsByTagName('script')[0];
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
            first.parentNode.insertBefore(tag, first);
          }

          function whenIdle() {
            if (window.requestIdleCallback) window.requestIdleCallback(start, { timeout: 1000 });
            else setTimeout(start, 200);
          }

          EVENTS.forEach(function (e) {
            window.addEventListener(e, start, { capture: true, once: true, passive: true });
          });
          capTimer = setTimeout(start, HARD_CAP_MS);

          if (document.readyState === 'complete') whenIdle();
          else window.addEventListener('load', whenIdle, { once: true });
        })();
      </script>
    )}

    {drdEnabled && (
      /* Injected from script rather than rendered as a static <script src>,
         because whether it should load at all depends on the runtime hostname
         — the same build is served from both the preview and production hosts,
         and the tracker's CORS allow-list only covers the latter. See
         ANALYTICS.drd.hosts in constants.ts.
         The config object has to exist before drd-track.js evaluates, so it is
         set first and the tag appended after. */
      <script
        is:inline
        define:vars={{ endpoint: drd.endpoint, key: drd.key, src: drd.script, hosts: drd.hosts }}
      >
        if (hosts.indexOf(window.location.hostname) !== -1) {
          // Config object must exist before drd-track.js evaluates.
          window.drdTrack = { endpoint: endpoint, key: key, debug: false };

          // Deferred on the same triggers as GTM (2026-08-17). PageSpeed listed
          // track.deepriverdigital.com as a preconnect candidate worth 160ms of
          // LCP, which is another way of saying it was loading inside the
          // critical path. Same trade as GTM: see the note above it.
          var drdStarted = false;
          var drdCap;
          var DRD_EVENTS = ['pointerdown', 'keydown', 'touchstart', 'scroll'];

          var startDrd = function () {
            if (drdStarted) return;
            drdStarted = true;
            clearTimeout(drdCap);
            DRD_EVENTS.forEach(function (e) {
              window.removeEventListener(e, startDrd, true);
            });
            var drdTag = document.createElement('script');
            drdTag.async = true;
            drdTag.src = src;
            document.head.appendChild(drdTag);
          };

          DRD_EVENTS.forEach(function (e) {
            window.addEventListener(e, startDrd, { capture: true, once: true, passive: true });
          });
          drdCap = setTimeout(startDrd, 10000);

          if (document.readyState === 'complete') {
            window.requestIdleCallback
              ? window.requestIdleCallback(startDrd, { timeout: 1000 })
              : setTimeout(startDrd, 200);
          } else {
            window.addEventListener('load', function () {
              window.requestIdleCallback
                ? window.requestIdleCallback(startDrd, { timeout: 1000 })
                : setTimeout(startDrd, 200);
            }, { once: true });
          }
        }
      </script>
    )}
  </>
)}
