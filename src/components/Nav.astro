---
import { Image } from 'astro:assets';
import { SITE_DATA, NAV, MOBILE_NAV } from '../data/constants';
import logo from '../assets/images/branding/Atlas-Accounting-logo.svg';

// Current path, normalised to the trailing-slash form the NAV hrefs use, so the
// active link can keep its hover treatment on. Blog post URLs (/blog/<slug>/)
// mark the Blog entry active too.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

{/* Announcement bar */}
<div class="bg-primary text-white">
  <div class="container mx-auto px-4 py-2 flex items-center justify-center gap-4 text-sm">
    <p>Calculate profit margins instantly</p>
    <a href="/profit-margin-calculator/" class="btn btn-accent px-3 py-1 text-xs">Try Calculator</a>
  </div>
</div>

<header class="bg-base-100 sticky top-0 z-50">
  <div class="navbar container mx-auto">
  <div class="navbar-start">
    <a href="/" class="flex items-center gap-2 px-2 py-2" aria-label={`${SITE_DATA.company.name} — Home`}>
      <Image src={logo} alt={`${SITE_DATA.company.name} logo`} class="h-15 w-auto" height={120} />
    </a>
  </div>

  <nav class="navbar-center hidden lg:flex" aria-label="Main">
    <ul class="menu menu-horizontal px-1">
      {NAV.main.map((item) => (
        <li>
          <a href={item.href} class={isActive(item.href) ? 'is-active' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
      <li class="relative" data-more-menu>
        <button
          type="button"
          class:list={['flex items-center gap-1', NAV.more.some((i) => isActive(i.href)) && 'is-active']}
          aria-expanded="false"
          aria-controls="more-menu"
          data-more-toggle
        >
          More
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </button>
        <ul id="more-menu" class="hidden absolute right-0 top-full z-10 mt-1 min-w-56 flex-col p-2 shadow-lg bg-base-100 rounded-box border border-base-300" data-more-panel>
          {NAV.more.map((item) => (
            <li>
              <a href={item.href} class={isActive(item.href) ? 'is-active' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </nav>

  <div class="navbar-end gap-2">
    {/* On mobile the header shows only the hamburger; Book a Call lives inside the menu panel */}
    <a href={SITE_DATA.links.bookACall} class="btn btn-accent hidden lg:inline-flex">Book a Call</a>
    <button type="button" class="btn btn-ghost lg:hidden" aria-expanded="false" aria-controls="mobile-menu" data-mobile-toggle>
      <span class="sr-only">Menu</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </div>
  </div>
</header>

{/* Mobile menu panel.
    Fixed below the header rather than sticky, so the CTA row can be pinned to
    the bottom of the panel while only the link list scrolls. Groups collapse so
    all 16 destinations fit on a phone without a long scroll. */}
<nav
  id="mobile-menu"
  class="hidden lg:hidden fixed inset-x-0 top-[var(--header-h)] bottom-0 z-40 bg-base-100 border-t border-base-300 shadow-lg flex-col"
  data-mobile-panel-anchor
  aria-label="Mobile"
  data-mobile-panel
>
  <div class="flex-1 overflow-y-auto overscroll-contain px-4 py-3">
    <ul class="menu flex-col">
      {MOBILE_NAV.top.map((item) => (
        <li>
          <a href={item.href} class:list={['py-3', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>

    {MOBILE_NAV.groups.map((group) => (
      <details class="accordion border-t border-base-200" open={group.items.some((i) => isActive(i.href))}>
        <summary class="flex items-center justify-between gap-4 py-3.5 px-3 font-semibold text-secondary">
          {group.label}
          <svg class="accordion-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <ul class="menu flex-col pb-2">
          {group.items.map((item) => (
            <li>
              <a href={item.href} class:list={['py-2.5 pl-6', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>

  {/* Pinned CTA row — Call + Contact stay reachable without scrolling back */}
  <div class="shrink-0 border-t border-base-300 bg-base-100 p-4 pb-[max(1rem,env(safe-area-inset-bottom))] grid grid-cols-2 gap-3">
    <a href={SITE_DATA.company.phoneHref} class="btn btn-primary w-full">Call</a>
    <a href={SITE_DATA.links.bookACall} class="btn btn-accent w-full">Contact</a>
  </div>
</nav>

<script>
  // Accessible disclosure behavior for the "More" dropdown and mobile menu:
  // click toggles, Escape closes and refocuses the trigger, outside click closes.
  function wireDisclosure(toggleSel: string, panelSel: string) {
    const toggle = document.querySelector<HTMLButtonElement>(toggleSel);
    const panel = document.querySelector<HTMLElement>(panelSel);
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('hidden', !open);
      panel.classList.toggle('flex', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !panel.contains(e.target as Node)) {
        setOpen(false);
      }
    });
  }

  wireDisclosure('[data-more-toggle]', '[data-more-panel]');
  wireDisclosure('[data-mobile-toggle]', '[data-mobile-panel]');

  // The mobile panel is fixed and covers the viewport below the header. Two
  // things need handling on open, both keyed off the class change so we don't
  // duplicate wireDisclosure's open/close logic:
  //
  // 1. Anchor the panel to the header's *measured* bottom. The announcement bar
  //    above the header scrolls away while the header stays sticky, so the
  //    header's bottom edge is --header-h only once the bar is gone; at the top
  //    of the page it sits lower and a fixed offset would clip the first link.
  // 2. Lock the page behind it, or scrolling past the panel's end scrolls the
  //    page underneath.
  const mobilePanel = document.querySelector<HTMLElement>('[data-mobile-panel]');
  const header = document.querySelector<HTMLElement>('header');

  if (mobilePanel && header) {
    new MutationObserver(() => {
      const open = !mobilePanel.classList.contains('hidden');
      if (open) {
        mobilePanel.style.top = `${Math.max(0, header.getBoundingClientRect().bottom)}px`;
      } else {
        mobilePanel.style.top = '';
      }
      document.body.style.overflow = open ? 'hidden' : '';
    }).observe(mobilePanel, { attributes: true, attributeFilter: ['class'] });
  }
</script>
