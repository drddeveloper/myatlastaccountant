---
import { Image } from 'astro:assets';
import { SITE_DATA } from '../data/constants';
import lightLogo from '../assets/images/branding/Atlas-Accounting-light-logo.png';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-white">
  <div class="container mx-auto px-4 py-12 flex flex-col md:flex-row items-center justify-between gap-8">
    <a href="/" aria-label={`${SITE_DATA.company.name} — Home`}>
      <Image src={lightLogo} alt={`${SITE_DATA.company.name} logo`} class="h-14 w-auto" height={112} widths={[50, 101, 151]} sizes="50px" />
    </a>

    <div class="text-center text-sm space-y-3">
      <p>© {currentYear} {SITE_DATA.company.name}, a <a href={SITE_DATA.links.parentCompany} target="_blank" rel="noopener noreferrer" class="text-accent link">Lewis Group CPAs</a> company. All rights reserved</p>
      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <a href={SITE_DATA.company.phoneHref} class="text-accent link-hover">{SITE_DATA.company.phone}</a>
        <span class="text-white/40" aria-hidden="true">|</span>
        <a href={`mailto:${SITE_DATA.company.email}`} class="text-accent link-hover">{SITE_DATA.company.email}</a>
      </p>
      {/* Legal row. One wrapping line, same pipe-separated pattern as the
          contact line above it. Brand Guide is last: it is an internal
          reference, not a policy, and the three policies are what a visitor
          (or an auditor) comes to the footer looking for. */}
      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-white/70">
        <a href={SITE_DATA.links.privacyPolicy} class="link-hover hover:text-accent transition-colors">Privacy Policy</a>
        <span class="text-white/40" aria-hidden="true">|</span>
        <a href={SITE_DATA.links.termsOfService} class="link-hover hover:text-accent transition-colors">Terms of Service</a>
        <span class="text-white/40" aria-hidden="true">|</span>
        <a href={SITE_DATA.links.cookiePolicy} class="link-hover hover:text-accent transition-colors">Cookie Policy</a>
        {/* Opens the consent manager's second layer. The separator lives inside
            the wrapper so the row collapses to a clean "… | Cookie Policy |
            Brand Guide" rather than leaving a doubled pipe behind.

            Both the wrapper and the button ship hidden and are revealed by
            CookieConsent.astro only once a consent API exists — a blocked or
            failed CMP leaves no control that swallows clicks.

            usercentrics-psl is the vendor's own class for a privacy settings
            link. It does nothing while pslHide is false, but it means any
            future Termageddon snippet that targets .usercentrics-psl finds
            this control instead of silently missing it.

            display:contents so the wrapper is not a flex item and does not
            break the row's wrapping; `hidden` still wins because Tailwind's
            preflight marks [hidden] display:none !important. */}
        <span class="contents" data-privacy-settings-panel hidden>
          <span class="text-white/40" aria-hidden="true">|</span>
          {/* Styled as a link, not a .btn — a button fill would shout over the
              rest of this row. */}
          <button
            type="button"
            data-privacy-settings
            hidden
            class="usercentrics-psl link-hover hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors cursor-pointer"
          >Privacy Settings</button>
        </span>
        <span class="text-white/40" aria-hidden="true">|</span>
        <a href="/brand-guide/" class="link-hover hover:text-accent transition-colors">Brand Guide</a>
      </p>
    </div>

    <a
      href={SITE_DATA.links.socials.instagram}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Atlas Accounting Group on Instagram"
      class="inline-flex items-center justify-center h-11 w-11 rounded-full border border-white/40 text-white hover:border-accent hover:text-accent transition-colors focus-visible:outline-2 focus-visible:outline-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
      </svg>
    </a>
  </div>
</footer>
