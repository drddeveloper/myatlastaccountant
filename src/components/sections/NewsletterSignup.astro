---
/**
 * Newsletter signup band → ActiveCampaign (via /api/subscribe).
 *
 * Our own markup and styling — none of ActiveCampaign's embed CSS/JS is on the
 * page. The form posts same-origin to the Pages Function, which forwards to
 * AC's proc.php server-side (see functions/api/subscribe.js for why).
 *
 * Progressive enhancement: `action` and `method` are real, so with JavaScript
 * off the browser posts natively and the Function 303s to /thank-you/. With
 * JavaScript on, the submit is intercepted and the result renders inline.
 *
 * Fields mirror the AC form the client built: first name, last name, email —
 * all three required on their side.
 */
interface Props {
  heading?: string;
  subheading?: string;
  /** Surface tint. The blog band sits on peach; navy suits dark sections. */
  theme?: 'peach' | 'navy';
}

const {
  heading = 'Want tips straight in your inbox?',
  subheading = 'Get accounting tips for the trades. No spam, unsubscribe anytime.',
  theme = 'peach',
} = Astro.props;

const isNavy = theme === 'navy';
---

<section class={isNavy ? 'bg-primary' : 'bg-cream-dark'}>
  <div class="container mx-auto px-4 py-14 md:py-16">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class={`heading-display text-2xl md:text-3xl ${isNavy ? 'text-white' : 'text-primary'}`}>
        {heading}
      </h2>
      <p class={`mt-3 ${isNavy ? 'text-white/85' : ''}`}>{subheading}</p>

      <form
        class="mt-8 text-left"
        action="/api/subscribe"
        method="post"
        novalidate
        data-newsletter-form
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="nl-first" class="sr-only">First name</label>
            <input
              id="nl-first"
              name="firstname"
              type="text"
              class="input"
              autocomplete="given-name"
              placeholder="First name"
              required
            />
          </div>
          <div>
            <label for="nl-last" class="sr-only">Last name</label>
            <input
              id="nl-last"
              name="lastname"
              type="text"
              class="input"
              autocomplete="family-name"
              placeholder="Last name"
              required
            />
          </div>
          <div class="sm:col-span-2">
            <label for="nl-email" class="sr-only">Email address</label>
            <input
              id="nl-email"
              name="email"
              type="email"
              class="input"
              autocomplete="email"
              placeholder="Email address"
              required
            />
          </div>
        </div>

        {/* Honeypot. Hidden from sight and from assistive tech, and skipped in
            the tab order — only a bot fills it in. */}
        <div class="sr-only" aria-hidden="true">
          <label for="nl-company">Company</label>
          <input id="nl-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-5 flex justify-center">
          <button type="submit" class="btn btn-accent" data-newsletter-submit>
            Subscribe to Newsletter
          </button>
        </div>

        {/* One live region for both outcomes, so a screen reader hears the
            result without the focus moving. */}
        <p
          class="mt-4 text-center font-semibold hidden"
          role="status"
          aria-live="polite"
          data-newsletter-status
        ></p>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-newsletter-form]').forEach((form) => {
    const status = form.querySelector('[data-newsletter-status]');
    const button = form.querySelector('[data-newsletter-submit]');
    if (!(form instanceof HTMLFormElement) || !status || !button) return;

    const show = (message, ok) => {
      status.textContent = message;
      status.classList.remove('hidden');
      status.classList.toggle('text-accent-ink', !ok);
      status.classList.toggle('text-primary', ok);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      // Let the browser's own validation speak first — it beats a custom
      // message for keyboard and screen-reader users.
      if (!form.reportValidity()) return;

      button.setAttribute('disabled', '');
      show('Signing you up…', true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await response.json().catch(() => ({}));

        if (response.ok && data.ok) {
          form.reset();
          show('Thanks — you’re signed up.', true);
        } else {
          show(data.error || 'Something went wrong. Please try again.', false);
        }
      } catch {
        show('Could not reach the server. Please try again.', false);
      } finally {
        button.removeAttribute('disabled');
      }
    });
  });
</script>
