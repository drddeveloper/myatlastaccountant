---
import { Image } from 'astro:assets';
import LeadForm from './LeadForm.astro';
import ctaBgImg from '../../assets/images/home/Footer-CTA-card-background.jpg';

/**
 * The closing conversion band that ends every page: orange duotone photo (the
 * tint is baked into the JPG), a dark wash at the top so the white heading
 * stays legible, and the lead form on a white card.
 *
 * Replaced CalendlyCta (client direction, 2026-08-12) — same band, same
 * placement, form instead of the third-party scheduler. The old component is
 * kept in src/components/_archive/ in case the scheduler comes back.
 *
 * Only the heading changes page to page — pass it in. Everything else is fixed
 * so the band is identical everywhere.
 */
interface Props {
  /** Page-specific heading, e.g. "Find out how we can help your HVAC business" */
  heading?: string;
  /** Anchor id — in-page CTAs link to #schedule */
  id?: string;
}

const {
  heading = 'Find out how we can help your trade business',
  id = 'schedule',
} = Astro.props;
---

<section id={id} class="bg-accent relative overflow-hidden scroll-mt-[var(--header-h)]">
  <Image
    src={ctaBgImg}
    alt=""
    class="absolute inset-0 w-full h-full object-cover object-top"
    widths={[1280]}
    sizes="100vw"
    aria-hidden="true"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/25 to-transparent pointer-events-none"></div>
  <div class="container mx-auto px-4 py-16 md:py-20 relative">
    <h2 class="heading-display text-3xl md:text-4xl text-white text-center max-w-3xl mx-auto">
      {heading}
    </h2>
    <p class="mt-4 text-white text-center text-lg max-w-2xl mx-auto">
      Tell us about your business and we&rsquo;ll get your free assessment scheduled.
    </p>
    <div class="mt-10 max-w-3xl mx-auto shadow-xl">
      <LeadForm />
    </div>
  </div>
</section>
